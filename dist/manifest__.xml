<?xml version="1.0" encoding="UTF-8"?>
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:type="TaskPaneApp">

  <Id>f3b9c5c0-1234-4567-89ab-rolando-mezclar-preguntas</Id>
  <Version>1.0.0.0</Version>
  <Version>1.0.0.0</Version>
  <ProviderName>MC Lautaro's</ProviderName>
  <DefaultLocale>es-CL</DefaultLocale>
  <DisplayName DefaultValue="Mezclador de Preguntas"/>
  <Description DefaultValue="Mezcla preguntas de selección múltiple y sus opciones según estilos definidos." />

  <IconUrl DefaultValue="https://mclautaro.cl/plugin/smassets/icon-32.png"/>
  <HighResolutionIconUrl DefaultValue="https://mclautaro.cl/plugin/smassets/icon-64.png"/>
  <SupportUrl DefaultValue="https://mclautaro.cl/help"/>
  <AppDomains>
    <AppDomain>https://mclautaro.cl</AppDomain>
  </AppDomains>
  <Hosts>
    <Host Name="Word" />
  </Hosts>

  <DefaultSettings>
    <SourceLocation DefaultValue="https://mclautaro.cl/plugin/smsrc/taskpane.html" />
  </DefaultSettings>

  <Permissions>ReadWriteDocument</Permissions>

  <VersionOverrides xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
                    xsi:type="VersionOverridesV1_0">

    <Hosts>
      <Host xsi:type="Word">
        <Runtimes>
          <Runtime resid="Taskpane.Url" lifetime="long" />
          <Runtime resid="Commands.Url" lifetime="long" />
        </Runtimes>

        <ExtensionPoint xsi:type="PrimaryCommandSurface">
          <OfficeTab id="TabHome">
            <Group id="GrupoMezclar" label="Evaluaciones">
              <Control xsi:type="Button" id="btnMezclarPreguntas"
                       label="Mezclar Preguntas"
                       icon="assets/icon-32.png"
                       screentip="Mezclar preguntas y opciones"
                       supertip="Detecta preguntas y opciones según estilos y las mezcla aleatoriamente.">
                <Action xsi:type="ExecuteFunction">
                  <FunctionName>onMixQuestions</FunctionName>
                </Action>
              </Control>
            </Group>
          </OfficeTab>
        </ExtensionPoint>
      </Host>
    </Hosts>

    <Resources>
      <bt:Images xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0">
        <bt:Image id="icon-32" resid="icon-32" />
      </bt:Images>

      <bt:Urls xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0">
        <bt:Url id="Taskpane.Url" DefaultValue="https://mclautaro.cl/plugin/smsrc/taskpane.html" />
        <bt:Url id="Commands.Url" DefaultValue="https://mclautaro.cl/plugin/smsrc/commands.html" />
      </bt:Urls>
    </Resources>

  </VersionOverrides>
</OfficeApp>
